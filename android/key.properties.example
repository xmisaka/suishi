# ============================================================
#  岁时 · release 签名配置模板
#
#  用法：把本文件复制为同目录下的 key.properties，填入真实口令。
#  真正的 key.properties 已被 .gitignore 排除，不会进入版本库。
#
#  ⚠️ 缺失本文件时构建不会中断，会静默回落到 debug 签名 ——
#     打出来的包无法覆盖安装已发布的版本，务必确认签名生效。
# ============================================================

# 密钥文件名（相对于 android/app/）
storeFile=suishi-release.keystore

# 密钥库口令
storePassword=

# 密钥别名
keyAlias=suishi

# 密钥口令
keyPassword=
